// PortFlow SBX — San Pedro Bay Container Congestion Predictor & Port Operations Optimiser
// Data model for the Bob AI Hackathon L1 submission.
//
// Capacity constants for terminals are REAL published figures from Port of Long Beach
// terminal fact sheets (see docs/setup-guide.md for citations).
// Vessel queue rows + hourly congestion history shipped with the repo are a labelled
// DEMO dataset; scripts/ais contains the pipeline to replace them with real AccessAIS
// AIS-derived series (source: NOAA MarineCadastre AccessAIS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- terminals
model Terminal {
  id            String   @id @default(cuid())
  code          String   @unique // LBCT | ITS | PCT | TTI
  name          String // Long Beach Container Terminal ...
  pier          String // Pier E | Pier G | Pier J | Pier T
  berthLengthFt Int // total continuous berth length (real, fact sheet)
  deepseaBerths Int // number of deepsea berths (real, fact sheet)
  gantryCranes  Int // STS gantry cranes (real, fact sheet)
  capacityTeuM  Float? // annual throughput capacity, million TEU (real where published)
  zoneCode      String // forecast zone key, e.g. "Z-LBCT"
  note          String?
  berths        Berth[]

  @@index([zoneCode])
}

model Berth {
  id         String   @id @default(cuid())
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id])
  name       String // "E-1", "G-2", ...
  seq        Int
  lengthFt   Int
  depthFt    Float // alongside design draft
  cranesMax  Int // max STS cranes that can work this berth simultaneously

  @@unique([terminalId, name])
}

// ---------------------------------------------------------------- vessels
model Vessel {
  id             String  @id @default(cuid())
  mmsi           String  @unique
  name           String
  carrier        String
  vesselClass    String // ULCV | POST_PANAMAX | NEO_PANAMAX | PANAMAX | FEEDER
  loaFt          Int
  beamFt         Int
  draftFt        Float
  teuCapacity    Int
  importMoves    Int // discharge moves (TEU)
  exportMoves    Int // load moves (TEU)
  originPort     String // last port of call
  reeferUnits    Int // refrigerated containers (time-sensitive cargo)
  status         String // ANCHORAGE | DRIFTING | INBOUND
  anchorageZone  String // "San Pedro Anchorage A" etc.
  etaHours       Float // hours from model time t0 until vessel is ready to berth
  anchoredHours  Float // hours already spent waiting at anchor / drifting
  destZoneCode   String // preferred terminal zone (carrier service loop)

  @@index([status])
  @@index([destZoneCode])
}

// ---------------------------------------------------------------- congestion history
model CongestionReading {
  id         String   @id @default(cuid())
  zoneCode   String // Z-PORT (port-wide) or Z-LBCT / Z-ITS / Z-PCT / Z-TTI
  ts         DateTime
  hoursAgo   Int // 0 = most recent, grows into the past
  queueCount Int // vessels at anchor / waiting in approach
  avgWaitHrs Float // mean anchorage dwell of the queue (hours)
  index      Float // composite congestion index 0..100 (see docs)
  source     String // DEMO_AIS | AIS (real pipeline) 

  @@unique([zoneCode, hoursAgo])
  @@index([zoneCode, ts])
}

// ---------------------------------------------------------------- optimiser runs
model OptimiserRun {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  paramsJson      String // options used (move rates, crane caps, horizon)
  assignmentsJson String // full assignment list produced by the optimiser
  metricsJson     String // optimised metrics
  baselineJson    String // FIFO first-fit baseline metrics (for comparison)
  deltasJson      String // improvement deltas
  deferredJson    String // vessels that could not be served inside the horizon
}

// ---------------------------------------------------------------- 72h ops plan
model OpsPlan {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  horizonHours Int
  summaryJson  String
  shiftsJson   String
  textPlan     String // human-readable shift supervisor plan
}

// ---------------------------------------------------------------- Bob chat
model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  metaJson  String? // tools/actions the assistant executed + sources
  createdAt DateTime @default(now())

  @@index([createdAt])
}
