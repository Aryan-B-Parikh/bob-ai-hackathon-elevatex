# =============================================================================
# PortFlow SBX — environment template
# =============================================================================
# The Next.js app root is this `src/` folder, so Prisma and Next.js read
# `src/.env`. Create it from this template (both files live in src/):
#
#     cp .env.example .env        # run from src/
#
# NEVER commit a real `.env` file — the repository `.gitignore` excludes it.
# =============================================================================

# PostgreSQL connection string used by Prisma (schema: prisma/schema.prisma).
# The database must exist before `bun run db:push`:
#     createdb -U postgres portflow_sbx      # or: CREATE DATABASE portflow_sbx;
# Local defaults below match a stock PostgreSQL install on port 5432.
# Replace YOUR_PASSWORD (and user/host/port if needed) with your PostgreSQL login.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/portflow_sbx?schema=public"

# -----------------------------------------------------------------------------
# Optional: Bob's LLM mode
# -----------------------------------------------------------------------------
# No API key is required. Bob's answers are produced server-side through the
# z-ai-web-dev-sdk. If the SDK is unreachable, Bob automatically falls back to a
# deterministic answer built from the SAME engine output (mode: "deterministic"),
# so the numbers shown are always engine-computed.

# -----------------------------------------------------------------------------
# Optional: Next.js server port (defaults to 3000)
# -----------------------------------------------------------------------------
# PORT=3000
