# =============================================================================
# PortFlow SBX — backend environment template
# =============================================================================
# Copy to `.env` next to this file:  cp .env.example .env
# (.env is gitignored — never commit real credentials)
# =============================================================================

# PostgreSQL (SQLAlchemy + psycopg3). The database must exist first:
#   createdb -U postgres portflow
DATABASE_URL="postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/portflow"

# ---- Narrative LLM layer: IBM Bob (harness) preferred, then Claude, then deterministic ----
# auto = Bob if BOB_API_KEY + the `bob` CLI are present, else Claude if a key is set, else deterministic.
LLM_PROVIDER=auto
# BOB_API_KEY="bob_prod_..."      # do NOT commit a real key; set it in your shell instead
# BOB_TEAM_ID=""                  # only for a "general" API key
BOB_CLI=bob
BOB_MAX_TURNS=3
BOB_TIMEOUT_S=240
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---- API / CORS -------------------------------------------------------------
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---- External data sources (batch pipelines) --------------------------------
OPEN_METEO_BASE="https://api.open-meteo.com"
# San Pedro Bay reference point (Ports of LA / Long Beach)
REFERENCE_LAT=33.74
REFERENCE_LON=-118.20

# ---- Simulation (SimPy synthetic operations layer) --------------------------
SIM_SEED=20240817
SIM_HORIZON_HOURS=72

# ---- Phase 0 feature flags (default off; each owner flips their own when done) ----
FEATURE_WEATHER=false
FEATURE_QUALITY=false
FEATURE_UPLOAD=false
# W3 complete: tidal windows are a CP-SAT hard constraint and the tidal_window table is
# populated on demand (modelled curve, labelled harmonic-model) — see services/tides.py
FEATURE_TIDAL=true
# W3 complete: CP-SAT warm-start. Also settable per request via ?incremental=1 or the body.
FEATURE_INCREMENTAL=true
# W3 complete: berth add/remove, bunching, schedule-change scenarios + clone/rollback.
# Marker flag only — /api/scenarios/extended is on the frozen contract and always responds.
FEATURE_SCENARIOS_EXT=true
